{
  "name": "poly-trend-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Prediction-market intelligence terminal with a durable agent research runtime.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @polytrend/web",
    "build": "npm run build --workspace @polytrend/contracts && npm run build --workspace @polytrend/web",
    "lint": "npm run lint --workspace @polytrend/web",
    "typecheck": "npm run typecheck --workspace @polytrend/contracts && npm run typecheck --workspace @polytrend/web",
    "test": "npm run test --workspace @polytrend/web",
    "contracts:generate": "npm run generate --workspace @polytrend/contracts",
    "contracts:check": "npm run typecheck --workspace @polytrend/contracts",
    "eval:validate": "python evals/retrieval/validate_dataset.py",
    "eval:retrieval": "python evals/retrieval/evaluate.py",
    "stack:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "stack:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/health.ps1",
    "stack:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1"
  }
}
