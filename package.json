{
  "name": "poly-trend-v3",
  "version": "3.0.0",
  "private": true,
  "description": "Event expectations, cross-asset response research and reproducible simulation.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @polytrend/web",
    "build": "npm run build --workspace @polytrend/contracts && npm run build --workspace @polytrend/web",
    "lint": "npm run lint --workspace @polytrend/web",
    "typecheck": "npm run typecheck --workspace @polytrend/contracts && npm run typecheck --workspace @polytrend/web",
    "test": "npm run test --workspace @polytrend/web",
    "contracts:generate": "npm run generate --workspace @polytrend/contracts",
    "contracts:check": "npm run typecheck --workspace @polytrend/contracts",
    "contracts:export": "python scripts/export_contracts.py",
    "test:research": "python -m pytest services/research/tests/v3",
    "eval:v3": "python evals/v3/run.py",
    "capture:showcases": "python scripts/capture_showcases.py",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down"
  }
}
