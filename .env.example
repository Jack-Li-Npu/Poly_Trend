# Local stack
COMPOSE_PROJECT_NAME=polytrend-v2
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local-only defaults. Replace every secret before exposing the stack publicly.
POSTGRES_DB=polytrend
POSTGRES_USER=polytrend
POSTGRES_PASSWORD=polytrend_dev_only
REDIS_PASSWORD=polytrend_dev_only
DATABASE_URL=postgresql+asyncpg://polytrend:polytrend_dev_only@postgres:5432/polytrend
REDIS_URL=redis://:polytrend_dev_only@redis:6379/0

# Browser traffic uses the public URL. Server-side web requests use Docker DNS.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
POLYTREND_MCP_URL=http://localhost:8000/mcp
API_HEALTH_PATH=/healthz

# Server-side model configuration. Never prefix provider keys with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-5.6-sol
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
MODEL_MAX_CONCURRENCY=4
MODEL_DAILY_BUDGET_USD=10

# Evidence providers
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYTREND_LIVE_MARKET_DATA=true
PROVIDER_TIMEOUT_SECONDS=7
FRED_API_KEY=
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2

# Worker schedules and investigation limits
MARKET_SYNC_INTERVAL_SECONDS=60
ALERT_SCAN_INTERVAL_SECONDS=30
INVESTIGATION_MAX_STEPS=24
INVESTIGATION_MAX_TOOL_CALLS=40
INVESTIGATION_TIMEOUT_SECONDS=300

# Optional tracing. Keep sensitive evidence payloads disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=polytrend-v2
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional outbound proxy
HTTP_PROXY=
HTTPS_PROXY=
