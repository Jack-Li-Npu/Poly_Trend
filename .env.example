# Copy to .env. The shell / process manager must load it for local Python commands.
COMPOSE_PROJECT_NAME=polytrend-v3
WEB_PORT=3000
API_PORT=8000
POSTGRES_DB=polytrend
POSTGRES_USER=polytrend
# Required by Docker Compose; choose a local password before starting.
POSTGRES_PASSWORD=

# SQLite is used when DATABASE_URL is empty; PostgreSQL uses psycopg.
DATABASE_URL=
POLYTREND_SQLITE_PATH=data/polytrend-v3.db
INTERNAL_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POLYTREND_LIVE_MARKET_DATA=true
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com/v2
PROVIDER_TIMEOUT_SECONDS=8
# Opt-in live recording for saved live cases, maximum 20 contracts.
MARKET_CAPTURE_ENABLED=false
MARKET_SYNC_INTERVAL_SECONDS=300
INVESTIGATION_TIMEOUT_SECONDS=300

# Optional server-only keys. Missing keys produce explicit coverage gaps.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
# Optional independent text challenge; deterministic numerical analysis needs no model key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
